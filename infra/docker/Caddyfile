{
	email admin@hisgc.co.tz
}

# Port map (container:port) — must match each Next APP_PORT / core-api:
#   web         -> admin-web:3000
#   api         -> core-api:4001
#   customer    -> customer-web:3002
#   executive   -> executive-web:3001
#   supplier    -> supplier-web:3003
#   recruitment -> recruitment-web:3004
#   visitor     -> visitor-web:3005
#   parking     -> parking-web:3006
#   files       -> minio:9000
#
# For public Let's Encrypt: each subdomain DNS A = origin IP, Proxy OFF (grey).
# Until then, `tls internal` keeps origin HTTPS up for Cloudflare Full SSL.

api.hisgc.co.tz {
	encode gzip
	reverse_proxy core-api:4001
}

web.hisgc.co.tz {
	encode gzip
	reverse_proxy admin-web:3000
}

customer.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy customer-web:3002
}

executive.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy executive-web:3001
}

supplier.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy supplier-web:3003
}

recruitment.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy recruitment-web:3004
}

visitor.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy visitor-web:3005
}

parking.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy parking-web:3006
}

files.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy minio:9000
}
