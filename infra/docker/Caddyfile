{
	email admin@hisgc.co.tz
}

# Port map (container:port) — must match each Next APP_PORT / core-api:
#   web         -> admin-web:3000
#   api         -> core-api:4001  (/api/v1/reporting* -> reporting-service:4005)
#   customer    -> customer-web:3002
#   executive   -> executive-web:3001
#   supplier    -> supplier-web:3003
#   recruitment -> recruitment-web:3004
#   visitor     -> visitor-web:3005
#   parking     -> parking-web:3006
#   files       -> minio:9000   (S3 API / presigned downloads)
#   console     -> minio:9001   (MinIO Browser UI — do NOT use :9001 on the host)
#
# Public Let's Encrypt for all hosts (DNS A → origin, Proxy OFF / grey-cloud).
# Internal admin portals (HR, Branch, CCTV, …) live under web.hisgc.co.tz routes.
# Partner / owner / contractor paths are under recruitment / parking / visitor apps.

api.hisgc.co.tz {
	encode gzip
	handle /api/v1/reporting* {
		reverse_proxy reporting-service:4005
	}
	handle {
		reverse_proxy core-api:4001
	}
}

web.hisgc.co.tz {
	encode gzip
	reverse_proxy admin-web:3000
}

customer.hisgc.co.tz {
	encode gzip
	reverse_proxy customer-web:3002
}

executive.hisgc.co.tz {
	encode gzip
	reverse_proxy executive-web:3001
}

supplier.hisgc.co.tz {
	encode gzip
	reverse_proxy supplier-web:3003
}

recruitment.hisgc.co.tz {
	encode gzip
	reverse_proxy recruitment-web:3004
}

visitor.hisgc.co.tz {
	encode gzip
	reverse_proxy visitor-web:3005
}

parking.hisgc.co.tz {
	encode gzip
	reverse_proxy parking-web:3006
}

# S3 API + presigned object URLs (browser root often returns 403 — expected).
files.hisgc.co.tz {
	encode gzip
	reverse_proxy minio:9000
}

# MinIO Console (web UI). Port 9001 is NOT published on the host — use this HTTPS
# hostname instead of https://files.hisgc.co.tz:9001
console.hisgc.co.tz {
	encode gzip
	reverse_proxy minio:9001 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
