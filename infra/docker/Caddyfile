{
	email admin@hisgc.co.tz
}

api.hisgc.co.tz {
	encode gzip
	reverse_proxy core-api:4001
}

web.hisgc.co.tz {
	encode gzip
	reverse_proxy admin-web:3000
}

# New portal hosts: use internal TLS so Cloudflare Full SSL can reach
# origin immediately (Let's Encrypt HTTP-01 fails while orange-clouded).
# Optional later: grey-cloud DNS briefly, remove `tls internal`, reload
# Caddy to obtain public LE certs, then re-enable Proxied.

customer.hisgc.co.tz {
	tls internal
	encode gzip
	reverse_proxy customer-web:3002
}

