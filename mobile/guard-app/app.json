{
  "expo": {
    "name": "HIGHLINK Guard",
    "slug": "pssms-guard-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pssms-guard",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f2744"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tz.co.highlink.guard",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HIGHLINK Guard uses your location for clock-in, alertness, and patrol audit."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2744"
      },
      "package": "tz.co.highlink.guard",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HIGHLINK Guard uses your location for clock-in, alertness, and patrol audit."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
